# Copy this file to backend/.env for local development (docker-compose reads
# it from the repo root; see docker-compose.yml). Never commit a real .env.

# --- Application ---
APP_ENV=development
APP_PORT=8080

# --- Database ---
# Used directly by docker-compose to provision the MySQL container AND by
# the backend to connect to it (DB_HOST=mysql when running via Docker,
# DB_HOST=127.0.0.1 when running the backend natively against Docker's
# exposed port).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rohit2939
DB_NAME=resume_platform
DB_ROOT_PASSWORD=change_me_root_password

# --- JWT ---
# Generate real values with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRY=168h

# --- Google OAuth ---
# From https://console.cloud.google.com/apis/credentials -- leave blank to
# disable Google sign-in (the rest of auth works fine without it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# --- AI provider ---
# AI_PROVIDER=stub uses the deterministic, offline stub (see
# backend/internal/ai/stub.go) -- no API key needed, full pipeline works,
# but extraction/interview quality is heuristic, not real AI.
# AI_PROVIDER=gemini uses Google Gemini -- get a key at
# https://aistudio.google.com/apikey (format: AIzaSy...).
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# --- Rate limiting ---
RATE_LIMIT_RPM=120

# --- Frontend (Next.js reads NEXT_PUBLIC_* at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
